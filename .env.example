DATABASE_URL=sqlite:///./data/finn.db
# Optional comma-separated origins only when serving the frontend separately.
FINN_CORS_ORIGINS=
APP_ENV=local
NSE_REQUEST_DELAY_SECONDS=0.35
YAHOO_REQUEST_DELAY_SECONDS=0.4
# Model router (any OpenAI-compatible endpoint). Defaults target Google Gemini's free tier.
# Get a key at https://aistudio.google.com/apikey. Model features are disabled while the key is blank.
FINN_LLM_API_KEY=
# FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FINN_LLM_FAST_MODEL=gemini-3.5-flash-lite     # bulk: results tables, guidance extraction, Q&A
# FINN_LLM_STRONG_MODEL=gemini-3.8-flash        # reasoning: promised-vs-delivered assessment only
# FINN_LLM_FAST_RPM=12
# FINN_LLM_STRONG_RPM=8

# Optional web search for management-change backgrounds (one of these; free tiers are enough).
# TAVILY_API_KEY=
# SERPER_API_KEY=
# End-of-day scheduler (in-process). Weekdays at this IST time; set FINN_SCHEDULER=off to disable.
# FINN_EOD_TIME=16:45
# FINN_SCHEDULER=on
