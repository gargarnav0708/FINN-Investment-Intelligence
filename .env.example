DATABASE_URL=sqlite:///./data/finn.db
# Optional comma-separated origins only when serving the frontend separately.
FINN_CORS_ORIGINS=
APP_ENV=local
NSE_REQUEST_DELAY_SECONDS=0.35
YAHOO_REQUEST_DELAY_SECONDS=0.4
# Optional OpenAI-compatible retrieval model. No provider is used when these are blank.
# FINN_LLM_BASE_URL=https://your-provider.example/v1
# FINN_LLM_MODEL=your-model-name
# FINN_LLM_API_KEY=
